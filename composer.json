{
    "name": "filagora/filagora-compliance",
    "description": "Cookie consent, policy versions and privacy requests (export and erasure) for Filagora.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "filagora",
        "gdpr",
        "cookie-consent",
        "privacy"
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "filagora/filagora-core": "^0.2",
        "filagora/filagora-entitlements": "^0.2"
    },
    "require-dev": {
        "filagora/filagora-cms": "^0.2.1",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Filagora\\Compliance\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Filagora\\Compliance\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Filagora\\Compliance\\ComplianceServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "filagora/filagora-cms": "Creates a new cookie policy version when the cookie policy page is published."
    }
}
